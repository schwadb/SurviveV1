[Unit]
Description=Kolibri Educational Server (Khan Academy)
After=network.target local-fs.target

[Service]
Type=simple
User=pi
Environment="KOLIBRI_HOME=/mnt/survive/kolibri"
ExecStart=/usr/local/bin/kolibri start --foreground --port=8082
Restart=on-failure
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=append:/var/log/survive_kolibri.log
StandardError=append:/var/log/survive_kolibri.log

[Install]
WantedBy=multi-user.target

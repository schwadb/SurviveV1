[Unit]
Description=Kolibri Educational Server (Khan Academy)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive

[Service]
Type=simple
User=pi
Environment="KOLIBRI_HOME=/mnt/survive/kolibri"
ExecStart=/usr/local/bin/kolibri start --foreground --port=8082
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=3
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-kolibri

[Install]
WantedBy=multi-user.target

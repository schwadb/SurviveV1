[Unit]
Description=Kolibri Educational Server (Khan Academy)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive

# Restart rate limiting belongs in [Unit]; systemd ignores these keys in
# [Service] ("Unknown key ... ignoring"), so the limit never applied.
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=pi
Environment="KOLIBRI_HOME=/mnt/survive/kolibri"
ExecStart=/usr/local/bin/kolibri start --foreground --port=8082
Restart=on-failure
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-kolibri

[Install]
WantedBy=multi-user.target

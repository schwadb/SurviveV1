[Unit]
Description=Kiwix Server (Offline Wikipedia & Books)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive

[Service]
Type=simple
User=pi
ExecStartPre=/bin/mkdir -p /mnt/survive/zim
# --threads 2 is enough for a single-user appliance; 4 ate RAM without benefit.
# No --address: kiwix-serve 3.x validates the value against real interface
# addresses and rejects the 0.0.0.0 wildcard ("IP address is not available on
# this system"). Omitting it listens on all interfaces, which is the intent.
ExecStart=/usr/local/bin/kiwix-serve \
    --library /mnt/survive/.kiwix_library.xml \
    --port 8081 \
    --threads 2
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
# Cold-loading a large Wikipedia ZIM on a Pi takes 5-15 min.
TimeoutStartSec=300
TimeoutStopSec=30
# kiwix-serve mmaps the ZIM files; with cgroup v2 that mapped page cache counts
# toward this limit, so 1G caused constant reclaim thrashing on a 100 GB
# Wikipedia archive. 4G leaves room to cache hot pages on a 16 GB Pi.
MemoryMax=4G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-kiwix

[Install]
WantedBy=multi-user.target

[Unit]
Description=Kiwix Server (Offline Wikipedia & Books)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive

[Service]
Type=simple
User=pi
ExecStartPre=/bin/mkdir -p /mnt/survive/zim
# --threads 2 is enough for a single-user appliance; 4 ate RAM without benefit.
ExecStart=/usr/local/bin/kiwix-serve \
    --library /mnt/survive/.kiwix_library.xml \
    --port 8081 \
    --address 127.0.0.1 \
    --threads 2
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
# Cold-loading a large Wikipedia ZIM on a Pi takes 5-15 min.
TimeoutStartSec=300
TimeoutStopSec=30
# Cap against libkiwix memory-leak patterns seen on ARM.
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-kiwix

[Install]
WantedBy=multi-user.target

[Unit]
Description=Martin Tile Server (Offline Maps)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive

# Restart rate limiting belongs in [Unit]; systemd ignores these keys in
# [Service] ("Unknown key ... ignoring"), so the limit never applied.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pi
ExecStart=/usr/local/bin/martin \
    --config /mnt/survive/maps/martin_config.yaml \
    --listen-addresses 0.0.0.0:3000
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-maps

[Install]
WantedBy=multi-user.target

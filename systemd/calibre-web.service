[Unit]
Description=Calibre-Web (Offline Ebook Library)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive

[Service]
Type=simple
User=pi
# Calibre-Web keeps its own application state (settings, users, sessions)
# SEPARATE from the Calibre book library:
#   -p  path to the settings DB   (NOT a port — 8083 is the built-in default)
#   -g  path to the gdrive DB
#   -i  listen address
# Keeping app state in .calibre-web/ stops it polluting the book library, and
# the dot-prefix keeps it out of the dashboard's content walks.
Environment="CALIBRE_DBPATH=/mnt/survive/.calibre-web"
# systemd starts units in / , which is not writable; Calibre-Web creates files
# relative to the cwd, so point it at its own writable state directory.
WorkingDirectory=/mnt/survive/.calibre-web
ExecStartPre=/bin/mkdir -p /mnt/survive/.calibre-web /mnt/survive/books/calibre-library
ExecStart=/opt/survive/venv/bin/cps \
    -p /mnt/survive/.calibre-web/app.db \
    -g /mnt/survive/.calibre-web/gdrive.db \
    -i 0.0.0.0
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-calibre

[Install]
WantedBy=multi-user.target

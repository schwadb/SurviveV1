[Unit]
Description=SurviveV1 Meshtastic Web Client (static files on :8084)
After=network.target local-fs.target
Wants=local-fs.target
RequiresMountsFor=/mnt/survive
# The client is fetched by download/comms.sh; stay inactive until it exists.
ConditionPathExists=/mnt/survive/comms/meshtastic-web/index.html

StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pi
WorkingDirectory=/mnt/survive/comms/meshtastic-web
# The build uses absolute asset paths, so it needs its own origin rather than
# a sub-path of the dashboard. Python's stdlib server is enough for a SPA.
ExecStart=/usr/bin/python3 -m http.server 8084 --bind 0.0.0.0 --directory /mnt/survive/comms/meshtastic-web
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=survive-meshtastic

[Install]
WantedBy=multi-user.target

{
  "expo": {
    "name": "Survive Budget",
    "slug": "survive-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.survive.budget",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Survive Budget with Face ID."
      }
    },
    "android": {
      "package": "com.survive.budget",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Survive Budget with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2a78d6"
        }
      ]
    ]
  }
}

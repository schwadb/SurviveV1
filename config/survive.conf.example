# SurviveV1 Configuration
# Edit this file to customize your setup
# Generated by: bash setup/first_run.sh

# ── Storage ────────────────────────────────────────────────────────────────────
SURVIVE_STORAGE_PATH="/mnt/survive"
SURVIVE_STORAGE_DEV="SKIP"
SURVIVE_BUDGET_GB="800"
SURVIVE_HOSTNAME="survive"

# ── Content flags (Y=download, N=skip) ────────────────────────────────────────
CONTENT_WIKIPEDIA="Y"
CONTENT_WIKIPEDIA_NOPIC="N"
CONTENT_WIKIBOOKS="Y"
CONTENT_STACKEXCHANGE="Y"
CONTENT_GUTENBERG="Y"
CONTENT_KOLIBRI="Y"
CONTENT_VIDEOS="Y"
CONTENT_MAPS="Y"
CONTENT_PDFS="Y"
CONTENT_AI_MODELS="Y"
CONTENT_IFIX="Y"
# Curated extras (~7 GB): Kiwix post-disaster/medicine/water/food/knots
# collections, Appropedia, Energypedia, PhET simulations, Wikiversity
CONTENT_EXPANSION="Y"
# Offline app installers (~1 GB): Kiwix Android/Desktop, F-Droid, VLC, so
# guests joining the hotspot can install the reader apps with no internet.
CONTENT_APPS="Y"

# ── Video quality (480, 720, 1080) ─────────────────────────────────────────────
VIDEO_QUALITY="720"

# ── AI model preference ────────────────────────────────────────────────────────
SURVIVE_AI_MODEL="survive"

# Point the dashboard at a REMOTE Ollama server instead of the local one, so a
# more powerful x86 mini-PC can do inference while the Pi stays the always-on
# node. Leave blank to use the Pi's own Ollama. On the satellite box run Ollama
# with OLLAMA_HOST=0.0.0.0 so it accepts LAN connections.
#   e.g. SURVIVE_OLLAMA_HOST="http://192.168.1.50:11434"
# Economical satellite tiers (Pi stays primary, powered only when needed):
#   ~$150-220 used Dell OptiPlex/HP EliteDesk micro (32 GB) -> 7-9B @ 5-8 tok/s
#   ~$500-800 Minisforum Ryzen 7840HS/8945HS + 780M       -> 8B @ 12-17 tok/s
SURVIVE_OLLAMA_HOST=""

# Rate-limit counter storage. Default (blank => memory://) counts per gunicorn
# worker, so effective limits are ~2x with 2 workers. For exact limits install
# a local redis (apt install redis-server; pip install 'limits[redis]') and set:
#   SURVIVE_LIMITER_STORAGE="redis://127.0.0.1:6379"
SURVIVE_LIMITER_STORAGE=""

# ── Cloud sync ─────────────────────────────────────────────────────────────────
# Remote name as configured in rclone (run: bash sync/setup_rclone.sh)
SURVIVE_CLOUD_REMOTE="gdrive"
SURVIVE_CLOUD_PATH="SurviveV1"

# ── Map region ─────────────────────────────────────────────────────────────────
# Options: north-america, south-america, europe, africa, asia, world
MAP_REGION="north-america"

# ── Grid-down Wi-Fi hotspot ────────────────────────────────────────────────────
# Used by scripts/hotspot.sh — the Pi broadcasts its own network so devices can
# reach the knowledge base with no router. Password must be 8-63 characters.
SURVIVE_HOTSPOT_SSID="SurviveV1"
SURVIVE_HOTSPOT_PASS="survive2026"

# ── Skip AI Hat setup ──────────────────────────────────────────────────────────
# Set to true if you don't have the Hailo AI Hat
SKIP_AI_HAT="false"

# ── Bandwidth limiting ─────────────────────────────────────────────────────────
# Limit download speed to avoid saturating your internet connection
# Format: bytes/s integer, or 0 for unlimited
# Examples: 5242880 = 5 MB/s, 10485760 = 10 MB/s, 0 = unlimited
SURVIVE_BANDWIDTH_LIMIT="0"

# ── Web server timeouts (seconds) ──────────────────────────────────────────────
# Tune these up if services respond slowly on your hardware
SURVIVE_SERVICE_CHECK_TIMEOUT="1"   # port reachability check
SURVIVE_OLLAMA_LIST_TIMEOUT="2"     # fetching model list from Ollama
# AI chat streams token-by-token, so this is an IDLE timeout between chunks —
# not a cap on total answer length. It must cover the model COLD LOAD (7.6 GB
# from USB for gemma4:12b: 30-80 s on a Pi 5), hence 300.
# NOTE: the dashboard runs under systemd and does NOT read this file; this
# value only affects manual runs. The systemd default is baked into server.py.
SURVIVE_AI_CHAT_TIMEOUT="300"

# ── YouTube downloads ──────────────────────────────────────────────────────────
# YouTube blocks many automated downloads with "Sign in to confirm you're not a
# bot". Point ONE of these at credentials to fetch video content:
#   SURVIVE_YTDLP_COOKIES  path to a cookies.txt exported from a logged-in browser
#   SURVIVE_YTDLP_BROWSER  read cookies live from a local browser (e.g. chromium)
# Leave both empty to attempt anonymous downloads (blocked items are skipped).
SURVIVE_YTDLP_COOKIES=""
SURVIVE_YTDLP_BROWSER=""
